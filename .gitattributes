# Episode media and music beds live in Git LFS (see AGENTS.md, "Media storage").
# Text artefacts (scripts, scenes, timing.json, *.words.json, index.html) stay plain git.
episodes/**/*.wav filter=lfs diff=lfs merge=lfs -text
episodes/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
episodes/**/*.flac filter=lfs diff=lfs merge=lfs -text
episodes/**/*.m4a filter=lfs diff=lfs merge=lfs -text
episodes/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
episodes/**/*.mov filter=lfs diff=lfs merge=lfs -text
episodes/**/*.webm filter=lfs diff=lfs merge=lfs -text
episodes/**/*.jpg filter=lfs diff=lfs merge=lfs -text
episodes/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
episodes/**/*.png filter=lfs diff=lfs merge=lfs -text
episodes/**/*.webp filter=lfs diff=lfs merge=lfs -text
brand/music/*.mp3 filter=lfs diff=lfs merge=lfs -text
brand/music/*.wav filter=lfs diff=lfs merge=lfs -text

# The demo episodes stay in plain git, so a clone or bundle without LFS still has a working example.
episodes/demo-*/** !filter !diff !merge !text

# Release bundle (git archive): only the demo episodes, and no music beds (archive would ship LFS pointers).
episodes/** export-ignore
episodes/demo-* -export-ignore
episodes/demo-*/** -export-ignore
brand/music/*.mp3 export-ignore
brand/music/*.wav export-ignore
